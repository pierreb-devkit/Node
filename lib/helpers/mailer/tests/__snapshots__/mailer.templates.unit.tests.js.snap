exports[`mailer baseline render — all shared templates: renders reset-password-email with every referenced variable present in its fixture 1`] = `"Dear Alice, You have requested to reset your password on Acme Click the button below to choose a new password: Reset password Button not working? https://acme.test/reset The Acme Support Team. If you didn't make this request, you can ignore this email. Please do not reply to this email, you can contact us here ."`;

exports[`mailer baseline render — all shared templates: renders signup-invite with every referenced variable present in its fixture 1`] = `"You've been invited — complete your signup Hello, You've been invited to join Acme . Click the button below to create your account: Create your account Button not working? https://acme.test/invite The Acme Team. If you weren't expecting this invitation you can ignore this email. Please do not reply to this email, you can contact us here ."`;

